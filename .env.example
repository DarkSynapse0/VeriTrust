# =====================================================================
# VeriTrust environment variables
# Copy to .env.local for the web app, .env for contracts/scripts.
# Every variable here is read by typed Zod env loaders. Missing values
# fail loud at app startup — add new variables to the loader as well.
# =====================================================================

# ---------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------
# App URLs (used by SIWE, QR codes, PDF footers)
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
SIWE_DOMAIN=localhost:3000

# ---------------------------------------------------------------------
# Chain — Polygon Amoy testnet
# ---------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_CHAIN_NAME=polygon-amoy

# RPC providers (server-side only — never bundle)
ALCHEMY_API_KEY=
INFURA_API_KEY=

# Optional explicit overrides (otherwise computed from API keys above)
POLYGON_AMOY_RPC_URL_PRIMARY=
POLYGON_AMOY_RPC_URL_FALLBACK=

# Block explorer (for contract verification + UI links)
POLYGONSCAN_API_KEY=

# ---------------------------------------------------------------------
# Smart contract
# ---------------------------------------------------------------------
# Populated after deployment (Phase 1 task 2)
NEXT_PUBLIC_REGISTRY_ADDRESS=

# Deployer key — Hardhat scripts only. NEVER commit a funded key.
DEPLOYER_PRIVATE_KEY=

# Initial admin address granted DEFAULT_ADMIN_ROLE on deploy
INITIAL_ADMIN_ADDRESS=

# ---------------------------------------------------------------------
# Database — PostgreSQL (Supabase or Neon)
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veritrust?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/veritrust?schema=public

# ---------------------------------------------------------------------
# Cache + rate limiting — Upstash Redis
# ---------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------
# Object storage — Cloudflare R2 (S3-compatible)
# ---------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_CANONICAL=veritrust-canonical
R2_BUCKET_PDFS=veritrust-pdfs
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------
# Auth — SIWE + JWT
# ---------------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=
SESSION_COOKIE_NAME=veritrust_session
SESSION_TTL_SECONDS=86400

# SIWE nonce TTL
SIWE_NONCE_TTL_SECONDS=300

# ---------------------------------------------------------------------
# Webhooks (chain event listener)
# ---------------------------------------------------------------------
ALCHEMY_WEBHOOK_SIGNING_KEY=

# ---------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------
LOG_LEVEL=info
