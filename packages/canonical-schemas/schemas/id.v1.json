{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritrust.app/schemas/id.v1.json",
  "title": "ID credential",
  "description": "Identity document — student ID, employee ID, member card. Not a government ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "credentialType",
    "schemaVersion",
    "issuer",
    "recipient",
    "fields",
    "issuedAt"
  ],
  "properties": {
    "type": { "const": "veritrust.credential.v1" },
    "credentialType": { "const": "ID" },
    "schemaVersion": { "const": "1.0.0" },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["walletAddress", "name"],
      "properties": {
        "walletAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "idHash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "idHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idType", "memberNumber", "validFrom"],
      "properties": {
        "idType": { "type": "string", "minLength": 1, "maxLength": 100 },
        "memberNumber": { "type": "string", "minLength": 1, "maxLength": 100 },
        "department": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 100 },
        "validFrom": { "type": "string", "format": "date" }
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
