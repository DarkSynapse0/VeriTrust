{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritrust.app/schemas/degree.v1.json",
  "title": "Degree credential",
  "description": "Academic degree, diploma, or graduate certificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "credentialType",
    "schemaVersion",
    "issuer",
    "recipient",
    "fields",
    "issuedAt"
  ],
  "properties": {
    "type": { "const": "veritrust.credential.v1" },
    "credentialType": { "const": "DEGREE" },
    "schemaVersion": { "const": "1.0.0" },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["walletAddress", "name"],
      "properties": {
        "walletAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "idHash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "idHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["degree", "field", "institution", "graduationDate"],
      "properties": {
        "degree": { "type": "string", "minLength": 1, "maxLength": 100 },
        "field": { "type": "string", "minLength": 1, "maxLength": 200 },
        "institution": { "type": "string", "minLength": 1, "maxLength": 200 },
        "graduationDate": { "type": "string", "format": "date" },
        "honors": { "type": "string", "maxLength": 100 },
        "gpa": { "type": "string", "maxLength": 20 },
        "studentId": { "type": "string", "maxLength": 100 }
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
