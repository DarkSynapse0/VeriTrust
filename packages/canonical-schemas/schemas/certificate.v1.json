{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritrust.app/schemas/certificate.v1.json",
  "title": "Certificate credential",
  "description": "Professional certification, training completion, or non-degree credential.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "credentialType",
    "schemaVersion",
    "issuer",
    "recipient",
    "fields",
    "issuedAt"
  ],
  "properties": {
    "type": { "const": "veritrust.credential.v1" },
    "credentialType": { "const": "CERTIFICATE" },
    "schemaVersion": { "const": "1.0.0" },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["walletAddress", "name"],
      "properties": {
        "walletAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "idHash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "idHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificateName", "issuingBody", "completionDate"],
      "properties": {
        "certificateName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "issuingBody": { "type": "string", "minLength": 1, "maxLength": 200 },
        "completionDate": { "type": "string", "format": "date" },
        "level": { "type": "string", "maxLength": 100 },
        "credentialId": { "type": "string", "maxLength": 100 },
        "skillsAssessed": { "type": "string", "maxLength": 500 }
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
