{
  "name": "@veritrust/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, and generated client for VeriTrust.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate --schema ./schema.prisma",
    "postinstall": "prisma generate --schema ./schema.prisma",
    "db:generate": "prisma generate --schema ./schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema ./schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ./schema.prisma",
    "db:reset": "prisma migrate reset --schema ./schema.prisma --force",
    "db:studio": "prisma studio --schema ./schema.prisma",
    "db:seed": "tsx ./src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'db: no-op lint' && exit 0",
    "test": "echo 'db: no-op test' && exit 0",
    "clean": "rm -rf generated dist .turbo"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
