// VeriTrust — credential verification platform
// Source of truth for human-readable data; chain stores hashes only.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------
// Enums
// -----------------------------------------------------------------

enum CredentialType {
  DEGREE
  CERTIFICATE
  ID
}

/// PENDING — chain tx submitted, awaiting confirmation.
/// CONFIRMED — chain tx confirmed; canonical JSON in R2; PDF generated.
/// REVOKED — revocation tx confirmed.
/// FAILED — chain tx reverted or never confirmed before TTL.
enum CredentialStatus {
  PENDING
  CONFIRMED
  REVOKED
  FAILED
}

/// Mirrors the on-chain reason byte: ERROR=1, FRAUD=2, EXPIRED=3, OTHER=4.
enum RevocationReason {
  ERROR
  FRAUD
  EXPIRED
  OTHER
}

// -----------------------------------------------------------------
// Models
// -----------------------------------------------------------------

model Issuer {
  id                  String    @id @default(cuid())
  /// Lowercase 0x-prefixed Ethereum address — unique per issuer.
  walletAddress       String    @unique
  /// Legal name (used in PDFs and registry listings).
  name                String
  /// Optional display alias if different from `name`.
  displayName         String?
  description         String?
  websiteUrl          String?
  logoUrl             String?
  contactEmail        String?
  /// Cached from on-chain ISSUER_ROLE state. Authoritative source is the chain.
  isAuthorized        Boolean   @default(false)
  /// Counters maintained by the audit logger as credentials transition state.
  credentialsIssued   Int       @default(0)
  credentialsRevoked  Int       @default(0)
  authorizedAt        DateTime?
  deauthorizedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  credentials         Credential[]

  @@index([walletAddress])
  @@index([isAuthorized])
}

model Credential {
  id                  String            @id @default(cuid())
  /// 0x-prefixed bytes32 hex string. Matches the on-chain key.
  credentialHash      String            @unique
  credentialType      CredentialType
  /// Schema version used to canonicalize, e.g. "1.0.0".
  schemaVersion       String
  /// R2 object key for the canonical JSON blob.
  canonicalJsonR2Key  String
  canonicalJsonSize   Int
  /// Public-facing recipient name (no PII like email here).
  recipientName       String
  /// SHA-256 of the recipient identifier (email, etc.). Stored hex, lowercase.
  recipientIdHash     String
  issuerId            String
  issuedAt            DateTime
  expiresAt           DateTime?
  /// Registration tx hash (set when submitted, before confirmation).
  chainTxHash         String?
  chainConfirmedAt    DateTime?
  chainBlockNumber    BigInt?
  status              CredentialStatus  @default(PENDING)
  revokedAt           DateTime?
  revocationReason    RevocationReason?
  revocationTxHash    String?
  /// R2 object key for the cached generated PDF (regenerable).
  pdfR2Key            String?
  /// Free-form metadata not part of the canonical payload (UI hints, etc.).
  metadata            Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  issuer              Issuer            @relation(fields: [issuerId], references: [id])

  @@index([credentialHash])
  @@index([issuerId, status])
  @@index([issuerId, issuedAt])
  @@index([status])
  @@index([recipientIdHash])
}

/// Versioned JSON schemas for each credential type. The active row is the one
/// new credentials of a given type validate against.
model CredentialSchema {
  id              String         @id @default(cuid())
  credentialType  CredentialType
  version         String
  schemaJson      Json
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([credentialType, version])
  @@index([credentialType, isActive])
}

/// Append-only audit trail. Never store plaintext PII — payloadHash for
/// sensitive content, metadata only for non-PII fields (status, ids, hashes).
model AuditLog {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  action          String
  actorAddress    String?
  payloadHash     String?
  metadata        Json     @default("{}")
  /// SHA-256 of the source IP — usable for rate-limiting/forensics without
  /// retaining the raw IP.
  ipAddressHash   String?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorAddress])
  @@index([createdAt])
}
